[Unit]
Description=YunDrone BLE Command Gateway Server
After=bluetooth.service NetworkManager.service
Wants=bluetooth.service NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/yundrone/ble-command-gateway/current
Environment=YUNDRONE_BLE_ADV_BACKEND=auto
Environment=YUNDRONE_LOG_COLOR=always
Environment=YUNDRONE_DEVICE_PREFIX=yundrone
# Optional on multi-adapter hosts:
# Environment=YUNDRONE_BLE_ADAPTER=hci0
ExecStartPre=/opt/yundrone/ble-command-gateway/current/deploy/systemd/prepare-ble-adapter.sh
ExecStartPre=-/usr/bin/bluetoothctl pairable off
ExecStart=/opt/yundrone/ble-command-gateway/current/yundrone-ble-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
